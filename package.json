{
  "name": "qodercli-for-vscode",
  "displayName": "QoderCLI for VS Code",
  "description": "Run the Qoder CLI coding agent in a VS Code terminal — it automatically sees your live editor context: active file, cursor line, selected code, and open files. No @file typing, no copy-paste.",
  "version": "0.4.2",
  "publisher": "yushuailong",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yushuailong/QoderCLI_for_VSCode.git"
  },
  "bugs": {
    "url": "https://github.com/yushuailong/QoderCLI_for_VSCode/issues"
  },
  "homepage": "https://github.com/yushuailong/QoderCLI_for_VSCode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "terminal": {
      "profiles": [
        {
          "id": "qoder-cli",
          "title": "Qoder CLI",
          "icon": "terminal"
        }
      ]
    },
    "commands": [
      {
        "command": "qoder-cli.openTerminal",
        "title": "Qoder CLI: Open Terminal"
      }
    ],
    "keybindings": [
      {
        "command": "qoder-cli.openTerminal",
        "key": "ctrl+shift+q",
        "mac": "cmd+alt+q"
      }
    ],
    "configuration": {
      "title": "Qoder CLI Editor Context",
      "properties": {
        "qoder.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the qoder executable. When left empty, qoder is looked up automatically from `PATH`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
